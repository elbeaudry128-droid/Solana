# Observation par défaut : aucune clé, construction, signature ou envoi de transaction.
DRY_RUN=true

# Le mode observation se connecte quand même au RPC/WebSocket et à RugCheck.
RPC_URL=https://api.mainnet-beta.solana.com
# Facultatif : sinon l'adresse WebSocket est déduite du RPC.
# WS_URL=wss://api.mainnet-beta.solana.com

# Montant en SOL ; slippage en pourcentage (au plus deux décimales).
BUY_AMOUNT=0.1
SLIPPAGE=1

# Facultatif ; JITO_TIP est en SOL (au plus neuf décimales).
USE_JITO=false
JITO_BLOCK_ENGINE_URL=frankfurt.mainnet.block-engine.jito.wtf
JITO_TIP=0.001

# Facultatif : au démarrage, active les requêtes GET Jupiter Tokens en observation.
# Si activé, les mints recherchés sont transmis à Jupiter. Clé API facultative ;
# si utilisée, elle est distincte de JUPITER_API_KEY et ne doit pas être vide.
JUPITER_TOKENS_ENABLED=false
JUPITER_TOKENS_POLL_INTERVAL_MS=5000
# JUPITER_TOKENS_API_KEY=votre_cle_api_tokens

# Le mode réel est désactivé. Aucune clé n'est nécessaire dans cette version.
# Ne jamais publier un éventuel fichier .env contenant des secrets.
